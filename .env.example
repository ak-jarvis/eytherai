# Eyther Phase 1 environment template.
# Copy values into platform secret/env tooling only. Do not commit real secrets.

# Local API/web ports used by verifier scripts when overridden.
API_PORT=3021
WEB_PORT=3020

# Railway API / worker runtime.
NODE_ENV=production
PORT=<supplied-by-platform>
DATABASE_URL=<railway-postgres-url>
EYTHER_AUTH_STORE=prisma
EYTHER_PHASE1_STORE=prisma
CORS_ORIGINS=<vercel-preview-or-production-origin>

# Vercel frontend runtime.
NEXT_PUBLIC_API_BASE_URL=<railway-api-url>/api/v1

# External release-gate verifier inputs.
RAILWAY_API_URL=<railway-api-url>
VERCEL_PREVIEW_URL=<vercel-preview-url>
